17:["$","section","Limits that reduce, not remove, loss",{"children":[["$","h2",null,{"className":"text-base font-semibold","children":"Limits that reduce, not remove, loss"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted","children":"Each round has a loss ceiling (1% of the vault) and the vault a total ceiling (8%). A fall of 5% in a day pauses new bets. A deposit cap applies at launch. The vault only accepts prices that are verified on chain from the oracle, and does not trade if they are missing."}]]}]
18:["$","section","Timing",{"children":[["$","h2",null,{"className":"text-base font-semibold","children":"Timing"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-muted","children":"Deposits and withdrawals settle once per window at one price for everyone. You cannot enter or leave at an exact moment. If the price needed to settle a window is missing, the window expires and requests are refundable."}]]}]
