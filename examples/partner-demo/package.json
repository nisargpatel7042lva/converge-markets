{
  "name": "partner-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A tiny Next.js page that embeds a Converge market with the vault's depth, built only with the public @converge/sdk.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:sdk-only": "node scripts/check-sdk-only.mjs",
    "create-market": "tsx scripts/create-market.ts"
  },
  "dependencies": {
    "@converge/sdk": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
