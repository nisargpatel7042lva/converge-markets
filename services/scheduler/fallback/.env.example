# Fallback scheduler (see docs/ops/scheduler-runbook.md). Never commit the filled .env.
RPC_URL=
FACTORY=
# SchedulerLens (one-call snapshot)
LENS=
# SchedulerReceiver (leader flag). Required unless STANDALONE=true (local tests only).
RECEIVER=
# STANDALONE=false
SCHEDULER_PRIVATE_KEY=
SERIES_CONFIG=/app/config/series.json
LOOP_INTERVAL_MS=10000
EPOCH=
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# /health returns 503 after this many consecutive bad ticks
UNHEALTHY_AFTER_BAD_TICKS=3
GAS_MULTIPLIER_PCT=120
MAX_RETRIES=3
LOG_LEVEL=info
ALERT_KIND=none
ALERT_WEBHOOK_URL=
TELEGRAM_CHAT_ID=
STREAMS_SOURCE=none
DATA_STREAMS_API_URL=https://api.dataengine.chain.link
DATA_STREAMS_API_KEY=
DATA_STREAMS_API_SECRET=
# TEST-ONLY (testnet/local with MockStreamsVerifierProxy)
STREAMS_TEST_SIGNER_KEY=
TEST_PRICE_FEEDS=
TEST_PRICE_RPC_URL=
