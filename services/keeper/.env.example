# Never commit real values. Copy to services/keeper/.env.
RPC_URLS=https://testnet-rpc.monad.xyz
WS_URL=wss://testnet-rpc.monad.xyz
# Addresses from deployments/testnet.json
VAULT=
VENUE=
# The vault's KEEPER role. Funded with MON for gas.
KEEPER_PRIVATE_KEY=
# live | dry-run | paper
MODE=dry-run
# testnet only: signer of MockStreamsVerifierProxy. Mainnet: STREAMS_SOURCE=data-streams + API creds.
STREAMS_SOURCE=test-signer
STREAMS_TEST_SIGNER_KEY=
# Bearer token for POST /kill and /unkill (>= 16 chars; unset disables the endpoints)
KILL_TOKEN=
# discord | telegram | none
ALERT_KIND=none
ALERT_WEBHOOK_URL=
TELEGRAM_CHAT_ID=
# Optional: Monad mainnet RPC used to sanity-check the price against the Chainlink push feed
SANITY_RPC_URL=
MAX_FEE_GWEI=300
